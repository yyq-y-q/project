# 复制为项目根 .env 后填写。生产务必：KB_ENV=production + 三把 API Key。

# ---- 必需 ----
DEEP_SEEK_KEY=

# ---- 运行环境 ----
# development | production（production 默认强制 API Key）
KB_ENV=development
# 可选覆盖：1=强制 API Key；0=允许开发兜底（仅本地）
# KB_REQUIRE_API_KEY=1

KB_HOST=0.0.0.0
KB_PORT=8000
# 多 worker 时 data/ 必须同盘可写（文件锁）；模型内存占用会翻倍，建议 1
KB_WORKERS=1
KB_LOG_LEVEL=INFO
# 浏览器跨域（逗号分隔）；留空则不启用 CORS
# KB_CORS_ORIGINS=https://kb.example.com

# 仅当应用位于已清洗 X-Forwarded-For 的可信反代之后才开启
# KB_TRUST_PROXY=1

# ---- 限流（生产默认开启；单 IP 每分钟 60 次、突发 30）----
# KB_RATE_LIMIT_ENABLED=1
# KB_RATE_LIMIT_RPM=60
# KB_RATE_LIMIT_BURST=30

# ---- 数据访问控制（ACL）----
# 未打标文档/表的默认策略：public（全部可读）| private（仅 admin）| deny（拒绝）
# 打标策略见 README「数据访问控制」；表级策略用 JSON：
# KB_SQL_TABLE_ACL_JSON={"sales":"admin,user","hr":"admin"}  # 缺省策略同上
# KB_ACL_UNTAGGED_POLICY=public
# KB_SQL_ACL_UNTAGGED_POLICY=public

# ---- 权限（生产必填至少一把）----
# 静态 key 可直接部署；更推荐由 admin 创建动态 key（明文只返回一次）。
# 每把 key 都绑定 operator + 角色 + 可选过期时间。
# KB_API_KEY_ADMIN=replace-with-long-random-admin
# KB_API_KEY_ADMIN_OPERATOR=platform-admin
# KB_API_KEY_ADMIN_EXPIRES_AT=2027-01-01T00:00:00Z
# KB_API_KEY_CHANGE_REQUESTER=replace-with-long-random-requester
# KB_API_KEY_CHANGE_REQUESTER_OPERATOR=knowledge-editor
# KB_API_KEY_CHANGE_REQUESTER_EXPIRES_AT=2027-01-01T00:00:00Z
# KB_API_KEY_APPROVER=replace-with-long-random-approver
# KB_API_KEY_APPROVER_OPERATOR=change-approver
# KB_API_KEY_APPROVER_EXPIRES_AT=2027-01-01T00:00:00Z
# KB_API_KEY_EXECUTOR=replace-with-long-random-executor
# KB_API_KEY_EXECUTOR_OPERATOR=release-operator
# KB_API_KEY_EXECUTOR_EXPIRES_AT=2027-01-01T00:00:00Z
# KB_API_KEY_AUDITOR=replace-with-long-random-auditor
# KB_API_KEY_AUDITOR_OPERATOR=compliance-auditor
# KB_API_KEY_AUDITOR_EXPIRES_AT=2027-01-01T00:00:00Z
# KB_API_KEY_USER=replace-with-long-random-user
# KB_API_KEY_USER_OPERATOR=knowledge-user
# KB_API_KEY_USER_EXPIRES_AT=2027-01-01T00:00:00Z
# KB_API_KEY_READONLY=replace-with-long-random-ro
# KB_API_KEY_READONLY_OPERATOR=readonly-user
# KB_API_KEY_READONLY_EXPIRES_AT=2027-01-01T00:00:00Z

# ---- OIDC 企业登录（可选；未配置时回退 API Key）----
# OIDC_ENABLED=1
# OIDC_ISSUER=https://login.example.com/realms/company
# OIDC_CLIENT_ID=private-kb-client
# OIDC_CLIENT_SECRET=your-oidc-secret
# OIDC_REDIRECT_URI=https://kb.example.com/auth/callback
# OIDC_SCOPE=openid profile email groups
# OIDC_ROLE_CLAIM=groups
# OIDC_ROLE_MAPPING={"kb-admins":"admin","kb-editors":"change_requester","kb-users":"user"}
# OIDC_SESSION_SECRET 必须是至少 32 字符的持久随机密钥；所有 worker 必须相同
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
# OIDC_SESSION_SECRET=replace-with-a-persistent-random-secret-of-32-chars-or-more

# ---- 治理与临时文件 ----
# 动态 key / 变更 / 审计链数据库；默认 data/governance.db
# KB_GOVERNANCE_DB=
# 临时文件默认保留 60 分钟，单文件最大 8MB
# KB_TEMP_FILE_TTL_MINUTES=60
# KB_TEMP_FILE_DIR=
# 审计与变更记录保留天数
KB_AUDIT_RETENTION_DAYS=365
